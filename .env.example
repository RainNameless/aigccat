# 复制成 .env 后按需填写。
# 单容器部署只需要 MINIO_ROOT_PASSWORD —— 其余不填也能启动，只是对应功能不可用，
# 界面会明确提示，不会伪造成功。
# 下面的模型名是开发时用的中转别名，请换成你自己网关 / 厂商的模型名。

# ===== 必填（容器启动需要）=====
MINIO_ROOT_PASSWORD=        # MinIO 密钥，请自己生成，勿用示例值
MINIO_ROOT_USER=aigccat

# ===== 文本 / 图片 =====
OPENAI_API_KEY=             # 文本生成、自动分类
OPENAI_BASE_URL=https://api.openai.com/v1   # 兼容 OpenAI 的中转端点也可
OPENAI_MODEL=gpt-5.4-mini
IMAGE_API_KEY=              # 三视图 / 图片创作
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=512x512          # 形如 512x512，单边 ≤2048；none 表示不强设

# ===== 生成 3D（官方开发者 API，与网页订阅额度不通用）=====
TRIPO_API_KEY=

# ===== 宿主工作器（可选，不在容器里）=====
BLENDER_WORKER_URL=http://host.docker.internal:8788   # 宿主机 scripts/blender/worker_server.py
# 网页订阅会话执行器：生成时消耗你账号的网页订阅积分，需要先接入你自己的会话，
# 接入方法与排查见 docs/STUDIO-SESSION.md。令牌由 install.py 自动生成并写入下面这一行。
STUDIO_WORKER_URL=http://host.docker.internal:8790
STUDIO_WORKER_TOKEN=
RIG_AGENT_TOKEN=            # AI 绑骨：scripts/opencode-runner/install-host.py 生成

# ===== 视觉模型（看图输出建模计划）=====
# 请选支持图片输入的模型；中转网关常见 60s 硬超时，输出 token 大的模型容易 504。
VISION_MODEL=gpt-5.4-mini

# ===== 其他（可选）=====
SERVICES_PUBLIC_ORIGIN=     # HTTPS 反代部署时填公开 Origin，如 https://example.com
BUILD_PROXY=                # 构建期代理（拉 crates），如 http://host.docker.internal:7897
