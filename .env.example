# ===== 必须填写 =====
MINIO_ROOT_PASSWORD=        # MinIO 生产密钥，勿用示例值

# ===== 阶段 2 起需要 =====
OPENAI_API_KEY=             # Character Spec 生成 + 自动分类
OPENAI_BASE_URL=https://api.openai.com/v1   # 兼容 OpenAI 的中转端点也可
OPENAI_MODEL=gpt-5.4-mini   # 默认用最省模型
IMAGE_API_KEY=              # 三视图生成（选型后填）

# ===== 阶段 4 起需要 =====
TRIPO_API_KEY=              # 图生 3D GLB

# ===== 可选 =====
MINIO_ROOT_USER=aigccat
WINDMILL_TOKEN=             # web 后端调 Windmill REST API 用，阶段 2 在 Windmill UI 生成

# ===== 建模（Blender 工作器 + 视觉模型）=====
BLENDER_WORKER_URL=http://host.docker.internal:8788   # 宿主机 scripts/blender/worker_server.py
VISION_MODEL=gpt-5.4-mini   # 看图输出建模计划；缺省 gpt-6-astra，但该模型在本中转 60s 网关超时下会 504

# ===== 网络（可选）=====
BUILD_PROXY=              # 构建期代理，如 http://host.docker.internal:7897（容器内访问宿主代理）
