[Unit]
Description=aigccat private workspace accounts
After=network.target
[Service]
Type=simple
User=aigccat-auth
Group=aigccat-auth
EnvironmentFile=/etc/aigccat-auth.env
ExecStart=/usr/bin/node /opt/aigccat-auth/server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aigccat-auth
UMask=0077
[Install]
WantedBy=multi-user.target
