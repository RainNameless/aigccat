FROM debian:bookworm-slim

# 仅构建阶段联网；运行阶段由运行器强制断网。
# 部分代理的 HTTP 502 不受 Acquire::Retries 重试，保留已下载包再尝试安装。
RUN apt-get -o Acquire::Retries=3 update \
    && (apt-get -o Acquire::Retries=3 install -y --no-install-recommends blender python3-numpy \
        || apt-get -o Acquire::Retries=3 install -y --no-install-recommends blender python3-numpy \
        || apt-get -o Acquire::Retries=3 install -y --no-install-recommends blender python3-numpy) \
    && blender --version > /opt/blender-version.txt \
    && rm -rf /var/lib/apt/lists/*

ENV HOME=/tmp \
    TMPDIR=/tmp \
    PYTHONNOUSERSITE=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=2 \
    OPENBLAS_NUM_THREADS=2
USER 1000:1000
WORKDIR /task
ENTRYPOINT ["blender"]
