// aigccat CI/CD 流水线
//
// 同一个脚本服务两条流水线（aigccat-prod / aigccat-dev）：
// 作业里用参数告诉它「部署到哪套环境、用哪个 compose 文件」，
// 所以本文件**不带任何环境专属信息**（域名、路径、口令都在 Jenkins 作业参数里）。
//
// 阶段：检出 → 后端单元测试 → 网关测试 → 构建镜像 → 部署 → 健康检查
//
// ⚠️ 本文件**故意不写 parameters{} 块**：流水线自带的 parameters 定义会**覆盖**
//    作业配置里的参数定义 —— 一旦在这里写了，aigccat-dev 作业就会拿到这里的默认值
//    （prod）而不是作业自己的值，表现为「dev 作业跑去部署生产」。
//    参数定义只保留在 Jenkins 作业侧（casc.yaml），这里只读 params.* 并给兜底值。
//
// ⚠️ 测试阶段用 `--volumes-from $(hostname)` 而不是 `-v $WORKSPACE/...`：
//    docker 守护进程在**宿主机**上执行，而 $WORKSPACE（/var/jenkins_home/...）只存在于
//    Jenkins **容器内**（它是个命名卷）。用 -v 挂一个宿主机上不存在的路径，Docker 会
//    默默建一个空目录挂进去 —— 报错是「could not find Cargo.toml in /app」，
//    完全看不出真正原因。--volumes-from 把 Jenkins 自己的卷挂载原样共享给测试容器，
//    于是路径两边一致。

pipeline {
  agent any

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    disableConcurrentBuilds()
    timeout(time: 90, unit: 'MINUTES')
  }

  environment {
    IMAGE_REPO = 'ghcr.io/rainnameless/aigccat'
    // 下面几个都从作业参数来，并给兜底值（万一在没有参数的场合直接跑这个脚本）
    ENVNAME    = "${params.ENVIRONMENT ?: 'prod'}"
    CMPFILE    = "${params.COMPOSE_FILE ?: ''}"
    ENVFILE    = "${params.ENV_FILE ?: ''}"
    // 依赖编译产物按环境分开缓存；放在宿主 /opt/ci-cache 上，首次全量编译后后续都很快
    CARGO_TARGET_DIR = "/ci-cache/cargo-target-${params.ENVIRONMENT ?: 'prod'}"
  }

  stages {
    stage('检出') {
      steps {
        checkout scm
        script {
          env.SHORT_SHA = sh(returnStdout: true, script: 'git rev-parse --short HEAD').trim()
          echo "分支 ${env.GIT_BRANCH} · 提交 ${env.SHORT_SHA} · 环境 ${env.ENVNAME}"
        }
      }
    }

    stage('后端单元测试') {
      when { expression { params.SKIP_TESTS != true } }
      steps {
        sh '''
          set -e
          docker run --rm \
            --volumes-from "$(hostname)" \
            -v /opt/ci-cache/cargo-config.toml:/usr/local/cargo/config.toml:ro \
            -v /root/.cargo/registry:/usr/local/cargo/registry:ro \
            -e CARGO_TARGET_DIR="$CARGO_TARGET_DIR" \
            -w "$WORKSPACE/web" \
            rust:1-slim-bookworm \
            cargo test --bin aigccat-web
        '''
      }
    }

    stage('网关测试') {
      when { expression { params.SKIP_TESTS != true } }
      steps {
        sh '''
          set -e
          docker run --rm \
            --volumes-from "$(hostname)" \
            -w "$WORKSPACE" \
            node:22-bookworm-slim \
            node --test scripts/auth-server/gateway.test.mjs
        '''
      }
    }

    stage('构建镜像') {
      steps {
        sh '''
          set -e
          docker buildx build \
            --platform linux/amd64 \
            --build-arg TARGETARCH=amd64 \
            --build-arg APT_MIRROR="${APT_MIRROR:-mirrors.ustc.edu.cn}" \
            -f deploy/allinone/Dockerfile \
            -t "$IMAGE_REPO:${ENVNAME}" \
            -t "$IMAGE_REPO:${ENVNAME}-${SHORT_SHA}" \
            --load .
          # 生产必须**同时**更新 :latest —— 仓库里的 docker-compose.allinone.yml 引用的就是它
          # （对普通用户而言那是对的）。只打 :prod 的话，compose 还会拉起上一次的镜像，
          # 表现是「流水线绿了但代码没上去」。dev 用独立的 :dev 标签，不碰 :latest。
          if [ "$ENVNAME" = "prod" ]; then
            docker tag "$IMAGE_REPO:${ENVNAME}-${SHORT_SHA}" "$IMAGE_REPO:latest"
            echo "已同步 :latest → ${SHORT_SHA}"
          fi
        '''
      }
    }

    stage('部署') {
      steps {
        sh '''
          set -e
          CMP="${CMPFILE:-$WORKSPACE/docker-compose.allinone.yml}"
          if [ -n "$ENVFILE" ]; then ENVARG="--env-file $ENVFILE"; else ENVARG=""; fi
          echo "compose : $CMP"
          echo "env-file: ${ENVFILE:-(无)}"
          # 项目名来自 compose 文件里的 name:，所以重建不会换数据卷
          docker compose $ENVARG -f "$CMP" up -d --force-recreate
          docker compose $ENVARG -f "$CMP" ps
        '''
      }
    }

    stage('健康检查') {
      steps {
        sh '''
          set -e
          CMP="${CMPFILE:-$WORKSPACE/docker-compose.allinone.yml}"
          if [ -n "$ENVFILE" ]; then ENVARG="--env-file $ENVFILE"; else ENVARG=""; fi
          # 进容器内部自检：Jenkins 在它自己的网络命名空间里，127.0.0.1 是它自己；
          # 而 dev 实例只把端口绑在宿主机回环上，跨容器根本摸不到。容器内网关端口恒为 8080。
          CID=$(docker compose $ENVARG -f "$CMP" ps -q | head -1)
          if [ -z "$CID" ]; then echo "没找到该 compose 项目的容器"; exit 1; fi
          echo "目标容器: $CID"
          for i in $(seq 1 30); do
            code=$(docker exec "$CID" curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
                     http://127.0.0.1:8080/login.html || true)
            echo "第 $i 次自检 → HTTP $code"
            case "$code" in
              2*) echo "健康检查通过"; exit 0 ;;
            esac
            sleep 4
          done
          echo "健康检查失败，容器最近日志："
          docker logs --tail 60 "$CID" 2>&1 | tail -60 || true
          exit 1
        '''
      }
    }
  }

  post {
    success {
      echo "✔ ${env.ENVNAME} 部署完成：${env.IMAGE_REPO}:${env.ENVNAME}（${env.SHORT_SHA}）"
    }
    unsuccessful {
      sh 'docker ps -a --format "{{.Names}}\t{{.Status}}" | grep -i aigccat || true'
    }
  }
}
